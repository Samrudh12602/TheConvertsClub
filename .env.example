# Copy to .env.local for development. Never commit real values.
# Each variable notes the phase that first needs it.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000        # Phase 0. Production: https://convertsclub.in
APP_ENV=development                              # Phase 0. production | preview | development. Hides demo content when "production".
ADMIN_EMAIL=                                     # Phase 1. Seeds the one Admin user.
CRON_SECRET=                                     # Phase 3. Bearer token Vercel Cron sends to /api/cron/*.

# --- Database (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL=                                    # Phase 1. Pooled connection, used by the app.
DIRECT_URL=                                      # Phase 1. Direct connection, used by prisma migrate.

# --- Auth.js ---
AUTH_SECRET=                                     # Phase 1. `openssl rand -base64 32`
AUTH_GOOGLE_ID=                                  # Phase 1.
AUTH_GOOGLE_SECRET=                              # Phase 1.

# --- Email (Resend) ---
RESEND_API_KEY=                                  # Phase 1.
EMAIL_FROM="The Convert Club <hello@convertsclub.in>"  # Phase 1. Domain must be verified (SPF/DKIM).

# --- Razorpay (test mode until go-live) ---
RAZORPAY_KEY_ID=                                 # Phase 2.
RAZORPAY_KEY_SECRET=                             # Phase 2. Server only.
RAZORPAY_WEBHOOK_SECRET=                         # Phase 2. Server only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=                     # Phase 2. Same value as RAZORPAY_KEY_ID (key id is public).

# --- Files and secrets ---
BLOB_READ_WRITE_TOKEN=                           # Phase 4. Vercel Blob (private).
ENCRYPTION_KEY=                                  # Phase 5. 32 bytes, base64. AES-GCM for mentor payout details. `openssl rand -base64 32`
